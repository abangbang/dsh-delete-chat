{
  "name": "dsh-delete-chat",
  "version": "0.4.3",
  "description": "真正删除 DSH 会话：归档 + 删目录 + 清记账。会话行「⋯」菜单里的危险操作，带确认与逐项结果。Real session deletion for DeepSeek Harness.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-delete-chat": "./bin/delete-chat.mjs"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "bin/delete-chat.mjs",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE",
    "install.ps1",
    "install.sh",
    "scripts/install.mjs"
  ],
  "scripts": {
    "test": "node --test test/host.test.mjs test/trash.test.mjs test/http.test.mjs test/client.test.mjs test/platform.test.mjs test/install.test.mjs",
    "pack": "node scripts/pack.mjs",
    "market-index": "node scripts/market-index.mjs",
    "rename-owner": "node scripts/rename-owner.mjs",
    "install-plugin": "node scripts/install.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "session-management",
    "delete",
    "archive",
    "cleanup"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YOUR_GITHUB_USER/dsh-delete-chat.git"
  },
  "homepage": "https://github.com/YOUR_GITHUB_USER/dsh-delete-chat#readme",
  "bugs": {
    "url": "https://github.com/YOUR_GITHUB_USER/dsh-delete-chat/issues"
  },
  "author": "YOUR_GITHUB_USER",
  "license": "MIT",
  "icon": "./icon.svg",
  "engines": {
    "node": ">=20"
  },
  "dshTarget": "0.2.1-rc.2",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    },
    "install": {
      "preferred": "tarball",
      "tarball": "https://github.com/YOUR_GITHUB_USER/dsh-delete-chat/archive/refs/heads/main.tar.gz",
      "zip": "https://github.com/YOUR_GITHUB_USER/dsh-delete-chat/archive/refs/heads/main.zip",
      "git": "https://github.com/YOUR_GITHUB_USER/dsh-delete-chat.git"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
